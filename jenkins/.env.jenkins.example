# Copy to jenkins/.env.jenkins (git-ignored) or run: make jenkins-env
# Names only; never commit real values.
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=
# file:///mirror/eduforecast.git for pre-push validation (scripts/devops/sync_mirror.sh),
# https://github.com/nktwn/eduforecast.git once the branch is pushed.
GIT_REPO_URL=
# Optional: Docker Hub push (access token, not the account password).
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=
