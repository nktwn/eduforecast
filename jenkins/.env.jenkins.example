# Copy to jenkins/.env.jenkins (git-ignored) or run: make jenkins-env
# Names only; never commit real values.
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=
# Repository the multibranch job scans. Default: the public GitHub repo.
# file:///mirror/eduforecast.git only for validating unpushed commits (scripts/devops/sync_mirror.sh).
GIT_REPO_URL=https://github.com/nktwn/eduforecast.git
# Optional: Docker Hub push (access token, not the account password).
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=
