# Copy to .env and fill in what you need. Names only: never commit real values.
# All variables are optional; without an LLM key the advisor works in briefing mode.

# AI advisor (OpenAI-compatible endpoint; Groq by default). ADVISOR_API_KEY takes precedence.
ADVISOR_API_KEY=
GROQ_API_KEY=
ADVISOR_BASE_URL=
ADVISOR_MODEL=
ADVISOR_TIMEOUT=

# Research data rebuild (OpenAlex)
OPENALEX_MAILTO=
OPENALEX_API_KEY=

# Advisor experiment only (src/advisor/experiment)
CEREBRAS_API_KEY=
ANTHROPIC_API_KEY=
