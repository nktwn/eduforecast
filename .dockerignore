# Allowlist: everything is excluded, then only what the images need is re-included.
*

!requirements-ci.txt
!pytest.ini
!app/
!src/
!tests/
!scripts/devops/
!.streamlit/config.toml
!data/aitu/
!data/research/raw/yearly_work_counts_I4405257690.json
# read by tests/test_advisor_facts.py and friends (tracked, small)
!results/academic_audit/*.csv
!results/academic_audit/*.md

# Never in the context, even inside re-included directories.
**/__pycache__
**/*.py[cod]
**/.env
**/.env.*
**/secrets.toml
**/.pytest_cache
**/.ruff_cache
**/.DS_Store
