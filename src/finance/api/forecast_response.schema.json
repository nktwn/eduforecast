{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eduforecast.local/contracts/finance-forecast/0.1.0",
  "title": "FinanceForecastResponse",
  "description": "Response of GET /finance/v0/institutions/{unitid}/forecast. One institution, all targets, next-year horizon.",
  "type": "object",
  "required": ["contract_version", "generated_at", "provider", "institution", "data_vintage", "horizon_year", "targets", "peers", "data_quality"],
  "additionalProperties": false,
  "properties": {
    "contract_version": {"const": "finance-forecast/0.1.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "provider": {
      "type": "object",
      "required": ["name", "is_mock", "is_demo", "model_version", "trained_through_year", "evaluated_against_criterion"],
      "additionalProperties": false,
      "properties": {
        "name": {"enum": ["mock", "demo-lightgbm"]},
        "is_mock": {"type": "boolean"},
        "is_demo": {"type": "boolean"},
        "model_version": {"type": "string"},
        "trained_through_year": {"type": ["integer", "null"]},
        "evaluated_against_criterion": {"type": "boolean"},
        "notes": {"type": "string"}
      }
    },
    "institution": {
      "type": "object",
      "required": ["unitid", "series_id", "name", "state", "control", "carnegie_group", "peer_group"],
      "additionalProperties": false,
      "properties": {
        "unitid": {"type": "integer"},
        "series_id": {"type": "integer"},
        "name": {"type": "string"},
        "state": {"type": "string"},
        "control": {"enum": ["public", "private_nonprofit"]},
        "carnegie_group": {"type": "string"},
        "peer_group": {"type": "string"}
      }
    },
    "data_vintage": {
      "type": "object",
      "required": ["source", "first_year", "last_year", "price_base"],
      "additionalProperties": false,
      "properties": {
        "source": {"type": "string"},
        "first_year": {"type": "integer"},
        "last_year": {"type": "integer"},
        "price_base": {"type": "string"}
      }
    },
    "horizon_year": {"type": "integer"},
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/target"}
    },
    "peers": {
      "type": "array",
      "items": {"$ref": "#/$defs/peer"}
    },
    "data_quality": {
      "type": "object",
      "required": ["flags"],
      "additionalProperties": false,
      "properties": {
        "flags": {"type": "array", "items": {"$ref": "#/$defs/flag"}}
      }
    }
  },
  "$defs": {
    "flag_code": {
      "enum": ["MOCK_DATA", "DEMO_MODEL", "COVID_YEAR", "GASB75_2018", "ID_TRANSITION", "MERGER_ABSORPTION",
               "NOT_ELIGIBLE", "SMALL_COHORT", "FINANCE_PARENT_CHILD", "FINANCE_PARTIAL", "MISSING_VALUE",
               "OUTLIER_CHANGE", "SHORT_HISTORY"]
    },
    "flag": {
      "type": "object",
      "required": ["code", "severity", "message"],
      "additionalProperties": false,
      "properties": {
        "code": {"$ref": "#/$defs/flag_code"},
        "severity": {"enum": ["info", "warning", "critical"]},
        "message": {"type": "string"},
        "year": {"type": ["integer", "null"]},
        "target": {"type": ["string", "null"]}
      }
    },
    "point": {
      "type": "object",
      "required": ["year", "value", "flags"],
      "additionalProperties": false,
      "properties": {
        "year": {"type": "integer"},
        "value": {"type": ["number", "null"]},
        "flags": {"type": "array", "items": {"$ref": "#/$defs/flag_code"}}
      }
    },
    "contribution": {
      "type": "object",
      "required": ["feature", "label", "feature_value", "contribution"],
      "additionalProperties": false,
      "properties": {
        "feature": {"type": "string"},
        "label": {"type": "string"},
        "feature_value": {"type": ["number", "string", "null"]},
        "contribution": {"type": "number"}
      }
    },
    "target": {
      "type": "object",
      "required": ["target", "label", "unit", "change_scale", "eligible", "history", "forecast", "baselines", "explanation", "peer_median_history"],
      "additionalProperties": false,
      "properties": {
        "target": {"enum": ["retention_rate", "grad_rate_150", "fall_enrollment", "core_total_per_fte_real"]},
        "label": {"type": "string"},
        "unit": {"type": "string"},
        "change_scale": {"enum": ["percentage_points", "log_ratio"]},
        "eligible": {"type": "boolean"},
        "ineligible_reason": {"type": ["string", "null"]},
        "history": {"type": "array", "items": {"$ref": "#/$defs/point"}},
        "forecast": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["year", "value", "predicted_change", "interval"],
              "additionalProperties": false,
              "properties": {
                "year": {"type": "integer"},
                "value": {"type": "number"},
                "predicted_change": {"type": "number"},
                "interval": {
                  "type": "object",
                  "required": ["level", "lower", "upper", "method"],
                  "additionalProperties": false,
                  "properties": {
                    "level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
                    "lower": {"type": "number"},
                    "upper": {"type": "number"},
                    "method": {"type": "string"}
                  }
                }
              }
            }
          ]
        },
        "baselines": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "value"],
            "additionalProperties": false,
            "properties": {
              "name": {"enum": ["naive", "peer_group_mean_growth"]},
              "value": {"type": ["number", "null"]}
            }
          }
        },
        "explanation": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["method", "scale", "base_value", "prediction", "contributions"],
              "additionalProperties": false,
              "properties": {
                "method": {"type": "string"},
                "scale": {"enum": ["percentage_points", "log_ratio"]},
                "base_value": {"type": "number"},
                "prediction": {"type": "number"},
                "contributions": {"type": "array", "items": {"$ref": "#/$defs/contribution"}}
              }
            }
          ]
        },
        "peer_median_history": {"type": "array", "items": {"$ref": "#/$defs/point"}}
      }
    },
    "peer": {
      "type": "object",
      "required": ["unitid", "name", "state", "distance", "latest"],
      "additionalProperties": false,
      "properties": {
        "unitid": {"type": "integer"},
        "name": {"type": "string"},
        "state": {"type": "string"},
        "distance": {"type": "number", "minimum": 0},
        "latest": {
          "type": "object",
          "additionalProperties": {"type": ["number", "null"]}
        }
      }
    }
  }
}
